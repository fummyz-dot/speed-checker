{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speed-checker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-16",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "netspeedrace.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
